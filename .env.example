# Copy to .env.local and fill in. .env.local is git-ignored.

# Required: a Jev (TypeSafe) API key.
# Get one at https://www.jevai.org/agent/keys or https://console.typesafe.ai/keys
TYPESAFE_API_KEY=

# Choose one writer connection. API keys and eligible CLI subscriptions are separate.
# Set LLM_PROVIDER to choose the default explicitly. Otherwise the app selects a
# configured API (Anthropic, OpenAI, Google, Gateway), then falls back to Claude Code.
ANTHROPIC_API_KEY=
# LLM_PROVIDER=claude-cli        # claude-cli | codex-cli | anthropic | openai | google | gateway | compatible
# LLM_MODEL=sonnet               # sonnet | opus | haiku, or a full model id
# LLM_MODEL_WRITE=               # per-task overrides: writing and repair,
# LLM_MODEL_EXTRACT=             # finding the ideas in a Must cover region,
# LLM_MODEL_JUDGE=               # and double-checking what Jev is unsure of
# LLM_CONCURRENCY=3              # parallel `claude -p` processes

# Local Codex CLI: install @openai/codex and run codex login.
# LLM_PROVIDER=codex-cli
# LLM_MODEL=default              # or an explicit Codex model ID
# CODEX_BIN=                     # optional absolute path to native codex executable

# Direct APIs. The model picker uses explicit routes; keys stay on the server.
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
AI_GATEWAY_API_KEY=
# Gateway supports provider/model IDs, e.g. openai/gpt-6-astra or mistral/mistral-large-3.
# OpenAI-compatible endpoints: OpenRouter, xAI, DeepSeek, Ollama, LM Studio, etc.
# LLM_BASE_URL=https://your-provider.example/v1
# LLM_API_KEY=
# LLM_MODEL=your-model-id
# LLM_STRUCTURED_OUTPUTS=true    # only if the endpoint supports JSON Schema
# Prefix per-task models to mix connections, e.g. LLM_MODEL_JUDGE=codex-cli/default.

# Decision backend (optional). Jev by default; Rizzo Flow is a local, Jev-compatible server.
# DECISION_PROVIDER=jev          # jev | rizzo
# DECISION_BASE_URL=             # default https://api.typesafe.ai or http://127.0.0.1:8017
# DECISION_MODEL=                # default jev-1.13.0 or rizzo-latest
# DECISION_API_KEY=              # defaults to TYPESAFE_API_KEY for Jev
